<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl"
       class="in-text"
       version="1.0.2"
       default-locale="en-GB">
  <info>
    <title>Health Policy and Planning - Mendeley Safe</title>
    <id>http://www.zotero.org/styles/health-policy-and-planning-mendeley-safe</id>
    <link href="http://www.zotero.org/styles/health-policy-and-planning-mendeley-safe" rel="self"/>
    <link href="https://academic.oup.com/heapol/pages/author-guidelines" rel="documentation"/>
    <category citation-format="author-date"/>
    <category field="medicine"/>
    <updated>2026-08-29T00:00:00+00:00</updated>
  </info>

  <macro name="author-citation">
    <names variable="author">
      <name form="short"
            and="text"
            delimiter=", "
            delimiter-precedes-last="never"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title" form="short"/>
      </substitute>
    </names>
  </macro>

  <macro name="author-bibliography">
    <names variable="author">
      <name name-as-sort-order="all"
            sort-separator=" "
            initialize-with=""
            delimiter=", "
            delimiter-precedes-last="never"/>
      <substitute>
        <names variable="editor"/>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="title">
    <choose>
      <if type="book report legislation" match="any">
        <text variable="title" font-style="italic"/>
      </if>
      <else>
        <text variable="title"/>
      </else>
    </choose>
  </macro>

  <citation et-al-min="3"
            et-al-use-first="1"
            disambiguate-add-year-suffix="true">
    <sort>
      <key macro="year"/>
      <key macro="author-citation"/>
    </sort>
    <layout prefix="(" suffix=")" delimiter="; ">
      <group delimiter=" ">
        <text macro="author-citation"/>
        <text macro="year"/>
      </group>
    </layout>
  </citation>

  <bibliography hanging-indent="false"
                entry-spacing="0"
                line-spacing="2">
    <sort>
      <key macro="author-bibliography"/>
      <key macro="year"/>
    </sort>
    <layout>
      <text macro="author-bibliography" suffix=". "/>
      <text macro="year" suffix=". "/>
      <text macro="title"/>

      <choose>
        <if type="article-journal" match="any">
          <group prefix=". " suffix=".">
            <text variable="container-title" font-style="italic"/>
            <text variable="volume" prefix=" " font-weight="bold"/>
            <text variable="page" prefix=": "/>
          </group>
        </if>

        <else-if type="chapter paper-conference" match="any">
          <group prefix=". ">
            <text term="in" text-case="capitalize-first" suffix=": "/>
            <names variable="editor" suffix=". ">
              <name name-as-sort-order="all"
                    sort-separator=" "
                    initialize-with=""
                    delimiter=", "
                    delimiter-precedes-last="never"/>
              <label form="short" prefix=" (" suffix=")"/>
            </names>
            <text variable="container-title" font-style="italic" suffix=". "/>
            <group delimiter=": ">
              <text variable="publisher-place"/>
              <text variable="publisher"/>
            </group>
            <text variable="page" prefix=", "/>
          </group>
        </else-if>

        <else>
          <group prefix=". " delimiter=": ">
            <text variable="publisher-place"/>
            <text variable="publisher"/>
          </group>
          <text variable="URL" prefix=". "/>
        </else>
      </choose>
    </layout>
  </bibliography>
</style>
